# .env.example — copy to .env; docker compose reads it.
DB_PASSWORD=your_secure_password
DB_ROOT_PASSWORD=your_root_password
# JWT_SECRET overrides jwt.secret from the backend config file (for Docker,
# backend/config.docker.yaml, whose value is a public placeholder). It signs
# session tokens and salts hashed IPs: set a long random string, e.g. the
# output of `openssl rand -hex 32`. Changing it signs everyone out.
JWT_SECRET=
# BASE_URL overrides urls.base_url (public URL of the redirect server that
# serves short links). Leave empty to use the config file's value.
BASE_URL=
